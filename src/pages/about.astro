---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { Icon } from 'astro-icon/components'

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sungho Park',
  url: SITE.href,
  description: 'Applied ML Engineer',
  jobTitle: 'AI Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'NAVER',
  },
  sameAs: [
    'https://github.com/gigio1023',
    'https://www.linkedin.com/in/gigio1023',
  ],
}
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:user' }]} />

  <section class="flex flex-col gap-10">
    <!-- Header -->
    <div>
      <h1 class="text-3xl font-bold md:text-4xl">Sungho Park</h1>
      <p class="text-muted-foreground mt-1">
        Applied ML Engineer — evaluation, reliability, and backend systems for
        LLM/agent products.
      </p>
    </div>

    <div class="prose prose-sm dark:prose-invert max-w-none space-y-8">
      <!-- Experience -->
      <div>
        <h2 class="mb-4 text-lg font-semibold">Experience</h2>
        <div class="space-y-4">
          <div class="border-primary border-l-2 pl-4">
            <div class="flex items-baseline justify-between">
              <h3 class="font-semibold">NAVER</h3>
              <span class="text-muted-foreground text-xs">2025.09 –</span>
            </div>
            <p class="text-muted-foreground text-sm">
              AI Engineer · Agent Orchestration
            </p>
          </div>
          <div class="border-muted border-l-2 pl-4">
            <div class="flex items-baseline justify-between">
              <h3 class="font-semibold">BHSN</h3>
              <span class="text-muted-foreground text-xs"
                >2024.07 – 2025.08</span
              >
            </div>
            <p class="text-muted-foreground text-sm">
              AI Engineer · LLM agent systems, RAG pipelines, evaluation
              frameworks
            </p>
          </div>
          <div class="border-muted border-l-2 pl-4">
            <div class="flex items-baseline justify-between">
              <h3 class="font-semibold">Wrtn Technologies</h3>
              <span class="text-muted-foreground text-xs"
                >2023.05 – 2024.07</span
              >
            </div>
            <p class="text-muted-foreground text-sm">
              ML Engineer · LLM inference optimization, streaming UX
            </p>
          </div>
          <div class="border-muted border-l-2 pl-4">
            <div class="flex items-baseline justify-between">
              <h3 class="font-semibold">NAVER Webtoon</h3>
              <span class="text-muted-foreground text-xs"
                >2022.12 – 2023.04</span
              >
            </div>
            <p class="text-muted-foreground text-sm">
              Applied Researcher Intern · Generative Research
            </p>
          </div>
          <div class="border-muted border-l-2 pl-4">
            <div class="flex items-baseline justify-between">
              <h3 class="font-semibold">Cipherome Korea</h3>
              <span class="text-muted-foreground text-xs"
                >2022.05 – 2022.12</span
              >
            </div>
            <p class="text-muted-foreground text-sm">
              ML Engineer · Advanced Research
            </p>
          </div>
        </div>
      </div>

      <!-- What I Work With -->
      <div>
        <h2 class="mb-4 text-lg font-semibold">What I Work With</h2>
        <div
          class="text-muted-foreground grid grid-cols-1 gap-3 text-sm sm:grid-cols-2"
        >
          <div>
            <span class="text-foreground font-medium"
              >Languages & Frameworks</span
            >
            <p>Python, FastAPI, PyTorch</p>
          </div>
          <div>
            <span class="text-foreground font-medium">LLM/Agent</span>
            <p>RAG, function calling, LangChain, vLLM/SGLang</p>
          </div>
          <div>
            <span class="text-foreground font-medium">Data & Evaluation</span>
            <p>Airflow, Elasticsearch, HF Transformers</p>
          </div>
          <div>
            <span class="text-foreground font-medium"
              >Infra & Observability</span
            >
            <p>Kubernetes, Prometheus, Grafana, VictoriaMetrics</p>
          </div>
        </div>
      </div>

      <!-- Publications & Talks -->
      <div>
        <h2 class="mb-4 text-lg font-semibold">Publications & Talks</h2>
        <ul class="text-muted-foreground space-y-2 text-sm">
          <li>
            <span class="text-foreground font-medium">SAFARI</span> — NAACL 2025 Findings
            (co-first author). LLM-as-Judge evaluation framework.
          </li>
          <li>
            <span class="text-foreground font-medium">Polyglot-Ko</span> — arXiv 2023.
            Large-scale Korean language model.
          </li>
          <li>
            <span class="text-foreground font-medium">Langcon 2025</span> — Rethinking
            Agents And Tools.
          </li>
          <li>
            <span class="text-foreground font-medium">Clova AI Rush 2022</span> —
            1st & 3rd place.
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h2 class="mb-4 text-lg font-semibold">Contact</h2>
        <div class="flex flex-wrap gap-4">
          <Link
            href="https://github.com/gigio1023"
            external
            class="text-muted-foreground hover:text-primary flex items-center gap-2 text-sm transition-colors"
          >
            <Icon name="lucide:github" class="size-4" />
            GitHub
          </Link>
          <Link
            href="https://www.linkedin.com/in/gigio1023"
            external
            class="text-muted-foreground hover:text-primary flex items-center gap-2 text-sm transition-colors"
          >
            <Icon name="lucide:linkedin" class="size-4" />
            LinkedIn
          </Link>
          <Link
            href="mailto:relilau00@gmail.com"
            class="text-muted-foreground hover:text-primary flex items-center gap-2 text-sm transition-colors"
          >
            <Icon name="lucide:mail" class="size-4" />
            Email
          </Link>
        </div>
      </div>
    </div>
  </section>
</Layout>
