---
import BlogPostLayout from '@/layouts/blog-post-layout.astro'
import {
  getAdjacentPosts,
  getAvailableTranslations,
  getCombinedReadingTime,
  getLocalizedTitle,
  getParentPost,
  getPostReadingTime,
  getSubpostCount,
  getTOCSections,
  hasSubposts,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const allPosts = await getCollection('blog')
  const koPosts = allPosts.filter(p => p.data.lang === 'ko' && !p.data.draft)
  return koPosts.map(post => ({
    params: { id: post.data.translationOf || post.id },
    props: post,
  }))
}

const post = Astro.props
const slug = post.data.translationOf || post.id
const currentPostId = slug

let Content: Awaited<ReturnType<typeof render>>['Content']
let headings: Awaited<ReturnType<typeof render>>['headings'] = []
try {
  const rendered = await render(post)
  Content = rendered.Content
  headings = rendered.headings ?? []
} catch (error) {
  console.error('Error rendering post content:', error)
  return Astro.redirect('/404')
}

let authors: Awaited<ReturnType<typeof parseAuthors>> = []
try {
  authors = await parseAuthors(post.data.authors ?? [])
} catch (error) {
  console.error('Error parsing authors:', error)
}

const postReadingTime = await getPostReadingTime(slug)
const translations = await getAvailableTranslations(slug)
const navigation = await getAdjacentPosts(slug)

const isCurrentSubpost = isSubpost(currentPostId)
let parentPost: Awaited<ReturnType<typeof getParentPost>> = null
let hasChildPosts = false
let subpostCount = 0
let combinedReadingTime: string | null = null
let tocSections: Awaited<ReturnType<typeof getTOCSections>> = []

try {
  parentPost = isCurrentSubpost ? await getParentPost(currentPostId) : null
  hasChildPosts = await hasSubposts(currentPostId)
  subpostCount = !isCurrentSubpost ? await getSubpostCount(currentPostId) : 0
  combinedReadingTime =
    hasChildPosts && !isCurrentSubpost
      ? await getCombinedReadingTime(currentPostId)
      : null
  tocSections = await getTOCSections(currentPostId, 'ko')
} catch (error) {
  console.error('Error fetching post metadata:', error)
}

if (navigation.newer) {
  const title = await getLocalizedTitle(navigation.newer, 'ko')
  navigation.newer = { ...navigation.newer, data: { ...navigation.newer.data, title } }
}
if (navigation.older) {
  const title = await getLocalizedTitle(navigation.older, 'ko')
  navigation.older = { ...navigation.older, data: { ...navigation.older.data, title } }
}
if (navigation.parent) {
  const title = await getLocalizedTitle(navigation.parent, 'ko')
  navigation.parent = { ...navigation.parent, data: { ...navigation.parent.data, title } }
}
---

<BlogPostLayout
  post={post}
  lang="ko"
  Content={Content}
  headings={headings}
  translations={translations}
  navigation={navigation}
  postReadingTime={postReadingTime}
  combinedReadingTime={combinedReadingTime}
  authors={authors}
  currentPostId={currentPostId}
  parentPost={parentPost}
  hasChildPosts={hasChildPosts}
  subpostCount={subpostCount}
  tocSections={tocSections}
/>
