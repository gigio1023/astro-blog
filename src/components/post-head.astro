---
import { DEFAULT_LANG, SITE } from '@/consts'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
  translations?: { lang: string; url: string }[]
}

const { post, translations = [] } = Astro.props

const title = post.data.title || SITE.title
const ogTitle = title
const description = post.data.description || SITE.description
const author =
  post.data.authors && post.data.authors.length > 0
    ? post.data.authors.join(', ')
    : SITE.author

const postUrl = new URL(Astro.url.pathname, Astro.site).href
const postImage = post?.data?.image?.src
  ? `${SITE.href}${post.data.image.src}`
  : new URL('/og-default.png', Astro.site).href
const publishedTime = post.data.date?.toISOString() || new Date().toISOString()
// Use published time as modified time if no updatedDate field exists
const modifiedTime = publishedTime

// Article Schema for better SEO and AI/GEO optimization
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: postImage,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: {
    '@type': 'Person',
    name: author,
    url: SITE.href,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.title,
    url: SITE.href,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/static/logo.png', Astro.site).href,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  url: postUrl,
  ...(post.data.tags &&
    post.data.tags.length > 0 && {
      keywords: post.data.tags.join(', '),
    }),
}
---

<title>{`${title} - ${SITE.title}`}</title>
<meta name="title" content={`${title} - ${SITE.title}`} />
<meta name="description" content={description} />
<link rel="canonical" href={postUrl} />

<!-- Enhanced Open Graph tags for AI/GEO optimization -->
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={postImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:type" content="article" />
<meta
  property="og:locale"
  content={post.data.lang === 'en'
    ? 'en_US'
    : post.data.lang === 'it'
      ? 'it_IT'
      : 'ko_KR'}
/>
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={postUrl} />
{
  translations
    .filter((t) => t.lang !== post.data.lang)
    .map(({ lang }) => (
      <meta
        property="og:locale:alternate"
        content={lang === 'en' ? 'en_US' : lang === 'it' ? 'it_IT' : 'ko_KR'}
      />
    ))
}
<meta property="article:published_time" content={publishedTime} />
<meta property="article:modified_time" content={modifiedTime} />
<meta property="article:author" content={author} />
{
  post?.data.tags &&
    post.data.tags.map((tag: string) => {
      return <meta property="article:tag" content={tag} />
    })
}

<!-- Enhanced Twitter Card tags -->
<meta name="twitter:url" content={postUrl} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={postImage} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={author} />

<!-- Article Schema Markup for AI/GEO and Rich Snippets -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(articleSchema)}
/>

{
  translations.length > 0 &&
    translations.map(({ lang, url }) => (
      <link
        rel="alternate"
        hreflang={lang}
        href={new URL(url, SITE.href).href}
      />
    ))
}
{
  translations.length > 0 &&
    (() => {
      const defaultTranslation =
        translations.find((t) => t.lang === DEFAULT_LANG) || translations[0]
      return (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(defaultTranslation.url, SITE.href).href}
        />
      )
    })()
}
