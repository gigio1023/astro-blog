---
---

<div id="lang-switcher">
  <div class="inline-flex items-center rounded-md border border-border/50 p-0.5 text-xs">
    <button
      id="lang-btn-ko"
      class="rounded px-5 py-0.5 font-medium transition-all duration-150 bg-foreground text-background shadow-sm"
      type="button"
    >
      KO
    </button>
    <button
      id="lang-btn-en"
      class="rounded px-5 py-0.5 font-medium transition-all duration-150 text-muted-foreground hover:text-foreground/80"
      type="button"
    >
      EN
    </button>
  </div>
</div>

<script>
  function getLang(): string {
    return localStorage.getItem('preferred-lang') || 'ko'
  }

  function setLang(lang: string) {
    localStorage.setItem('preferred-lang', lang)
    applyLang(lang)
    document.dispatchEvent(new CustomEvent('lang-switch', { detail: { lang } }))
  }

  function applyLang(lang: string) {
    document.querySelectorAll('[data-lang]').forEach((el) => {
      const htmlEl = el as HTMLElement
      if (htmlEl.dataset.langBtn) return
      htmlEl.style.display = htmlEl.dataset.lang === lang ? '' : 'none'
    })

    const btnEn = document.getElementById('lang-btn-en')
    const btnKo = document.getElementById('lang-btn-ko')
    const activeAdd = ['bg-foreground', 'text-background', 'shadow-sm']
    const activeRemove = ['text-muted-foreground', 'hover:text-foreground/80']
    const inactiveAdd = ['text-muted-foreground', 'hover:text-foreground/80']
    const inactiveRemove = ['bg-foreground', 'text-background', 'shadow-sm']

    if (btnEn) {
      if (lang === 'en') {
        btnEn.classList.add(...activeAdd)
        btnEn.classList.remove(...activeRemove)
      } else {
        btnEn.classList.add(...inactiveAdd)
        btnEn.classList.remove(...inactiveRemove)
      }
    }
    if (btnKo) {
      if (lang === 'ko') {
        btnKo.classList.add(...activeAdd)
        btnKo.classList.remove(...activeRemove)
      } else {
        btnKo.classList.add(...inactiveAdd)
        btnKo.classList.remove(...inactiveRemove)
      }
    }
  }

  function initLangSwitcher() {
    const switcher = document.getElementById('lang-switcher')
    const hasEn = document.querySelector('[data-lang="en"]')
    const hasKo = document.querySelector('[data-lang="ko"]')

    if (!hasEn || !hasKo) {
      if (switcher) switcher.style.display = 'none'
      return
    }

    if (switcher) switcher.style.display = ''

    const preferred = getLang()
    applyLang(preferred)

    document.getElementById('lang-btn-en')?.addEventListener('click', () => setLang('en'))
    document.getElementById('lang-btn-ko')?.addEventListener('click', () => setLang('ko'))
  }

  initLangSwitcher()

  document.addEventListener('astro:after-swap', initLangSwitcher)
</script>
